# All variables are optional. The app runs with real live data with none of
# these set — they raise rate limits or unlock the one field (route/ETA) that
# free ADS-B data structurally cannot provide.

PORT=3000

# OpenSky Network client-credentials OAuth2 app (raises the anonymous
# 400-credits/day limit). Create one at https://opensky-network.org under
# Account -> API Client. Leave unset to run anonymously.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Optional: real scheduled departure/arrival airport + ETD/ETA. ADS-B alone
# never carries flight-plan data, so without a schedule provider like this,
# the app correctly reports route/ETA as unavailable rather than guessing.
# Free tier (100 req/month) at https://aviationstack.com. This integration
# has not been exercised against a live key during development -- if
# AviationStack's response shape has since changed, adjust the mapping in
# server.js's /api/route/:callsign handler.
AVIATIONSTACK_KEY=
